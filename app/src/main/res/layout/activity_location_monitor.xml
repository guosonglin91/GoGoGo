<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="18dp"
            android:text="Location Monitor"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- System Location Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="System Location"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monitor_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Provider: -" />

        <TextView
            android:id="@+id/monitor_lat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latitude: -" />

        <TextView
            android:id="@+id/monitor_lon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Longitude: -" />

        <TextView
            android:id="@+id/monitor_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speed: -" />

        <TextView
            android:id="@+id/monitor_bearing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bearing: -" />

        <TextView
            android:id="@+id/monitor_accuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accuracy: -" />

        <TextView
            android:id="@+id/monitor_mock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="isMock: -" />

        <TextView
            android:id="@+id/monitor_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location time: -" />

        <TextView
            android:id="@+id/monitor_elapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="14dp"
            android:text="Age: -" />

        <Button
            android:id="@+id/monitor_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="读取当前系统位置" />

        <!-- Route Diagnostic Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:paddingTop="24dp"
            android:text="Route Test (V2-C Expected)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/route_test_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session: -" />

        <TextView
            android:id="@+id/route_test_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="State: no route session" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Canonical WGS84 Position"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/route_test_source_lat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WGS84 Latitude: -" />

        <TextView
            android:id="@+id/route_test_source_lon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WGS84 Longitude: -" />

        <TextView
            android:id="@+id/route_test_target_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Target Speed: -" />

        <TextView
            android:id="@+id/route_test_output_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Output Speed: -" />

        <TextView
            android:id="@+id/route_test_bearing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bearing: -" />

        <TextView
            android:id="@+id/route_test_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Distance: -" />

        <TextView
            android:id="@+id/route_test_lap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lap: -" />

        <TextView
            android:id="@+id/route_test_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Route time: -" />

        <TextView
            android:id="@+id/route_test_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Route age: -" />

        <TextView
            android:id="@+id/route_test_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress: -" />

        <TextView
            android:id="@+id/route_test_error_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="18dp"
            android:text="Error: -" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="V2-C 诊断说明：Route Test 显示控制器期望的 WGS84 路线样本；System Location 显示 Android LocationManager 实际观测值。百度地图坐标转换仅用于地图显示，不进入系统定位 Provider。"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>